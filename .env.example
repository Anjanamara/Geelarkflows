# Canonical production origin used by sitemap, prerendered flow pages, and IndexNow.
SITE_URL=https://geelarkflows.com

# Production provider secrets. Set deployed values with `wrangler secret put`.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
ADMIN_BOOTSTRAP_SECRET=

# Bootstrap must remain false except during one-time administrator provisioning.
ADMIN_BOOTSTRAP_ENABLED=false

# Add these after claiming the domain in Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Public IndexNow verification key. Change only if the matching public key file is replaced.
INDEXNOW_KEY=4a0e17038739472cad3cd17a15f9e39c

# Safe local-development settings. The mock stays bound to localhost by default.
VITE_DEV_HOST=127.0.0.1
ENABLE_LIVE_PAYMENT_MOCK=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_CRYPTO_WEBHOOK_SECRET=
