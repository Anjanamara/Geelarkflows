{
	"name": "geelarkflows",
	"main": "src/worker.js",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "geelarkflows.com",
			"custom_domain": true
		},
		{
			"pattern": "www.geelarkflows.com",
			"custom_domain": true
		}
	],
	"vars": {
		"SITE_URL": "https://geelarkflows.com",
		"ADMIN_BOOTSTRAP_ENABLED": "false"
	},
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "none",
		"run_worker_first": ["/*", "!/assets/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "geelarkflows_payment",
			"database_id": "d9f6006d-08ff-4869-9b3c-c0e068f4118a"
		}
	],
	"r2_buckets": [
		{
			"binding": "FLOWS_BUCKET",
			"bucket_name": "geelark-digital-assets"
		}
	]
}
